# menthTex deployment configuration.
# Copy to .env and fill in. Never commit the resulting .env.

# --- Database (compose creates this PostgreSQL instance for you) ------------
POSTGRES_DB=menthtex
POSTGRES_USER=menthtex
POSTGRES_PASSWORD=change_me

# --- Frontend base path ----------------------------------------------------
# Build-time value. Must match reverse-proxy subpath hosting, e.g. /menthtex/.
VITE_BASE_PATH=/

# --- Authentication (optional) ---------------------------------------------
# A provider is enabled only when ALL of its variables are set. With neither
# provider configured the public formatter still works, but the literature
# workspace at /app and definition management are unavailable.

# GitLab OAuth
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_REDIRECT_URI=http://localhost:4242/api/auth/callback
GITLAB_BASE_URL=https://gitlab.example.org

# Authentik OIDC
AUTHENTIK_ISSUER_URL=
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_REDIRECT_URI=http://localhost:4242/api/auth/callback/authentik
AUTHENTIK_GROUPS_CLAIM=groups
AUTHENTIK_SCOPES=openid profile email

# --- Sessions and access ---------------------------------------------------
# Comma-separated groups allowed to sign in. Checked at login time only.
AUTH_ALLOWED_GROUPS=kn-staff,kn-esslingen
AUTH_SESSION_TTL_HOURS=8
# Set to true when serving over HTTPS behind a reverse proxy.
AUTH_COOKIE_SECURE=false

# --- External metadata lookup ----------------------------------------------
EXTERNAL_METADATA_LOOKUP_ENABLED=true
EXTERNAL_METADATA_LOOKUP_TIMEOUT_SECS=6
